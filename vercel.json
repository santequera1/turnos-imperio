{
  "builds": [
    {
      "src": "turnos_app/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.8"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "turnos_app/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "turnos_app/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "turnos_app/wsgi.py"
    }
  ]
}
